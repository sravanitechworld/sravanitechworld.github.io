rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function enrolled() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && exists(/databases/$(database)/documents/enrollments/$(request.auth.token.email.lower()))
        && get(/databases/$(database)/documents/enrollments/$(request.auth.token.email.lower())).data.active == true;
    }
    match /enrollments/{email} {
      allow get: if request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == email;
      allow list, create, update, delete: if false;
    }
    match /lessons/{lessonId} {
      allow get, list: if enrolled();
      allow create, update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
